{
  "name": "cascade-madmapper",
  "version": "2.0.0",
  "description": "Cascade — séquenceur LED multi-couches pour MadMapper (OSC) : chases, vagues, couleur, presets, MIDI/OSC, Ableton Link",
  "author": "Pierre-Yves Mansour — Collectif WSK",
  "license": "MIT",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:ui": "node --test tests/ui.test.js",
    "test:mutation": "node tests/mutation.js",
    "sync-dist": "node sync-dist.js",
    "build": "node sync-dist.js && node build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": ["public/**/*"],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-linux-x64"
    ],
    "outputPath": "build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pymenvert/cascade.git"
  },
  "keywords": ["madmapper", "osc", "led", "dmx", "chaser", "lighting", "vj", "ableton-link"]
}
